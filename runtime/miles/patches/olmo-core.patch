+    block: TransformerBlockConfig | dict[str, TransformerBlockConfig]
+    resolved_block_pattern: list[str] | None
+    if len(blocks) == 1:
+        block = next(iter(blocks.values()))
+        resolved_block_pattern = None
+    else:
+        block = dict(blocks)
+        resolved_block_pattern = block_pattern

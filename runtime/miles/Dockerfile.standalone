# Experiment overlay: preserve the qualified stage-1 training dependencies.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=${SOURCE_REVISION}
RUN printf '%s\n' "$SOURCE_REVISION" > /opt/core-rl/source-revision
COPY open_instruct /opt/core-rl/open_instruct
COPY scripts/data/rl_readiness /opt/core-rl/scripts/data/rl_readiness
COPY scripts/miles /opt/core-rl/scripts/miles
COPY runtime/miles/runtime.lock.json /opt/core-rl/runtime/miles/runtime.lock.json
RUN python -m compileall -q /opt/core-rl/open_instruct/miles && python -c "from open_instruct.miles.rewards.candidate_verifiers import score; assert score('Answer: A', {'kind':'mcqa','value':'A','choices':['A','B']}) == 1"

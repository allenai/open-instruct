+@dataclasses.dataclass
+class DPOPretokenizedFormatting(grain.MapTransform):
+  """Prepares pre-tokenized DPO pairs (open-instruct's tokenized preference format).
+
+  Each sequence is fed whole: its first token is the shared "prompt" and the rest the completion, right-padded with
+  `pad_id`. Attention covers every real token; the loss mask is `labels[1:] != -100`, so it can differ from the
+  attention mask (untrained context after the last labelled token, or labels covering several spans).
+  Sequences longer than `max_target_length` are truncated from the right, as open-instruct truncates.
+  """
+
+  pad_id: int
+  max_target_length: int
+  data_column_names: tuple[str, ...]
+
+  def map(self, element):
+    """Apply the dataset transformations for pre-tokenized DPO."""
+    if len(self.data_column_names) != 4:
+      raise ValueError(
+          "dpo.pretokenized expects train_data_columns ['chosen_input_ids', 'chosen_labels', 'rejected_input_ids',"
+          f" 'rejected_labels'], got {self.data_column_names}"
+      )
+    chosen_ids, chosen_labels, rejected_ids, rejected_labels = (
+        np.asarray(element[c])[: self.max_target_length] for c in self.data_column_names
+    )
+    if chosen_ids.shape != chosen_labels.shape or rejected_ids.shape != rejected_labels.shape:
+      raise ValueError("input_ids and labels must have the same length.")
+    if chosen_ids[0] != rejected_ids[0]:
+      raise ValueError(f"chosen and rejected must start with the same token, got {chosen_ids[0]} and {rejected_ids[0]}.")
+    # The model derives attention from `!= pad_id` (no dense mask), so the pad id must not occur as a real token.
+    if (chosen_ids == self.pad_id).any() or (rejected_ids == self.pad_id).any():
+      raise ValueError(f"pad id {self.pad_id} occurs inside a sequence.")
+    for key in self.data_column_names:
+      del element[key]
+    width = self.max_target_length - 1
+    element["prompt_ids"] = chosen_ids[:1].astype(np.int32)
+    element["prompt_mask"] = np.ones(1, np.int32)
+    for name, ids, labels in (("chosen", chosen_ids, chosen_labels), ("rejected", rejected_ids, rejected_labels)):
+      n = ids.shape[0] - 1
+      element[f"{name}_ids"] = np.pad(ids[1:], (0, width - n), constant_values=self.pad_id).astype(np.int32)
+      element[f"{name}_mask"] = np.pad(np.ones(n, np.int32), (0, width - n))
+      element[f"{name}_loss_mask"] = np.pad((labels[1:] != -100).astype(np.int32), (0, width - n))
+    return element

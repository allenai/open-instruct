# CUDA 13.0.2 / Torch 2.13 compiler-equipped olmo-eval base (Beaker 01M5VBMKPG8BX4BVJBGVBMF64V).
# The evaluator owns its inline SGLang runtime independently of the training image.
ARG BASE_IMAGE=gcr.io/ai2-beaker-core/public/dbfeg0vbnsoc73aeq7d0@sha256:387ffbeba26a151142f7c30cd4ea9b5e5a741d54b57e6b43bd3ec3b117e85952
FROM ${BASE_IMAGE}
ARG OLMO_EVAL_REVISION=3536fe751e40162cc33d5e647085e986375aadce
LABEL ai2.olmo.eval.revision=${OLMO_EVAL_REVISION}
RUN git clone https://github.com/allenai/olmo-eval.git /opt/olmo-eval \
    && git -C /opt/olmo-eval checkout --detach ${OLMO_EVAL_REVISION} \
    && test "$(git -C /opt/olmo-eval rev-parse HEAD)" = "${OLMO_EVAL_REVISION}"
WORKDIR /opt/olmo-eval
# Export the provider's locked dependencies, retaining the base's CUDA Torch wheels.
# Supply --secret id=github_token,env=GH_TOKEN when a source dependency needs authentication.
RUN --mount=type=secret,id=github_token \
    export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=credential.helper \
        GIT_CONFIG_VALUE_0='!f() { echo username=x-access-token; printf "password="; cat /run/secrets/github_token; }; f'; \
    python -c "from importlib.metadata import version; from pathlib import Path; Path('/tmp/torch-constraints.txt').write_text(''.join(f'{p}=={version(p)}\\n' for p in ('torch', 'torchvision', 'torchaudio')))" \
    && uv export --frozen --no-default-groups --extra sglang --extra beaker --no-hashes --no-emit-project -o /tmp/evaluator-requirements.txt \
    && uv pip install -c /tmp/torch-constraints.txt -r /tmp/evaluator-requirements.txt \
    && uv pip install --no-deps . \
    && uv pip install -c /tmp/torch-constraints.txt wandb==0.23.1

ENV SGLANG_RETURN_ORIGINAL_LOGPROB=1

# CLI dry-run does not import provider dependencies; check the actual adapter.
RUN python -c "from olmo_eval.inference.providers import sglang; import olmo_sglang; assert callable(olmo_sglang.register)"

# Task names in the maintained background-evaluation example must resolve here.
RUN python -c "from olmo_eval.evals.tasks.common import get_task; [get_task(name) for name in ('gsm8k', 'gsm8k:platinum', 'ifeval_ood')]"

# CLI stop-list overrides must remain hashable for async request batching.
RUN python -c "from dataclasses import replace; from olmo_eval.cli.run.config import _parse_override_value; from olmo_eval.common.types import SamplingParams; [hash(replace(SamplingParams(), stop_sequences=_parse_override_value(value))) for value in ('[]', '[\"END\"]')]"

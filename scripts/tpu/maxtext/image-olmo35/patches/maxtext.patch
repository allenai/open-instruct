+  def map(self, element):
+    out = {}
+    for k, v in element.items():
+      v = np.asarray(v)
+      assert v.shape[0] == self.keep.sum(), (k, v.shape, int(self.keep.sum()))
+      full = np.zeros((len(self.keep),) + v.shape[1:], dtype=v.dtype)
+      full[self.keep] = v
+      out[k] = full
+    return out

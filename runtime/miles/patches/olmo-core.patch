+            source = native_state[name]
+            owner_name = name.rsplit(".", 1)[0]
+            owner = model.get_submodule(owner_name)
+            if getattr(owner, "_ep_sharded", False):
+                local_experts = int(owner.num_local_experts)
+                start = int(owner.ep_rank) * local_experts

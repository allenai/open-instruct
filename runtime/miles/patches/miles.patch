+    events = []
+    updater = _updater(depth=2)
+
+    def chunks():
+        for index in range(3):
+            events.append(f"export-{index}")
+            yield index
+
+    def send(index):
+        events.append(f"send-{index}")
+        return [f"ref-{index}"], MagicMock()
+
+    def wait(refs):
+        events.append(f"wait-{refs[0][-1]}")
+        return [(True, "Success")]
+
+    updater._send_base_params = send
+    mock_ray_get.side_effect = wait
+    updater._send_base_chunks(chunks())
+
+    assert events == [
+        "export-0",
+        "send-0",
+        "export-1",
+        "send-1",
+        "wait-0",
+        "export-2",
+        "send-2",
+        "wait-1",
+        "wait-2",
+    ]
+    assert mock_check.call_count == 3

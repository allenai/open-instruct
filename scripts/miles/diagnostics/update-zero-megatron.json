  "bootstrap_script": "# --- olmo-miles bootstrap (generated by `olmo-miles beaker launch`) ---\nif [[ \"${OLMO_MILES_LOCAL_GATE:-false}\" != true ]]; then\n  olmo_miles_fetch() {\n    local destination=$1 repository=$2 revision=$3\n    if [[ \"$(cat \"${destination}/.source-revision\" 2>/dev/null)\" == \"${revision}\" ]]; then\n      return 0\n    fi\n    echo \"olmo-miles bootstrap: fetching ${repository} @ ${revision} -> ${destination}\" >&2\n    local askpass\n    askpass=$(mktemp)\n    printf '#!/bin/sh\\necho \"${GITHUB_TOKEN:-}\"\\n' > \"${askpass}\" && chmod 700 \"${askpass}\"\n    local stage\n    stage=$(mktemp -d)\n    export GIT_ASKPASS=\"${askpass}\" GIT_TERMINAL_PROMPT=0 GIT_LFS_SKIP_SMUDGE=1\n    git -c credential.username=x-access-token -C \"${stage}\" init -q\n    git -c credential.username=x-access-token -C \"${stage}\" fetch -q --depth 1 \"${repository}\" \"${revision}\"\n    git -C \"${stage}\" checkout -q --force FETCH_HEAD\n    rm -rf \"${stage}/.git\"\n    printf '%s\\n' \"${revision}\" > \"${stage}/.source-revision\"\n    rm -rf \"${destination}.next\" && mv \"${stage}\" \"${destination}.next\"\n    rm -rf \"${destination}\" && mv \"${destination}.next\" \"${destination}\"\n    rm -f \"${askpass}\"\n  }\n  olmo_miles_fetch /src/olmo-miles https://github.com/allenai/olmo-miles.git \\\n    \"${OLMO_MILES_EXPECTED_REVISION:?launch with olmo-miles beaker launch}\" \\\n    || { echo \"olmo-miles bootstrap: fetching olmo-miles failed\" >&2; exit 1; }\nfi\n# --- end olmo-miles bootstrap ---\n",
  "bootstrap_provenance": "Original r3 runtime/libraries.py bootstrap function, unchanged from 0e648108c70c5d5256a9b93a88b4f8d610e44ea0; first retained log line confirms fetch into /src/olmo-miles."

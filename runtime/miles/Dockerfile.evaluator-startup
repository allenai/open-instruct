# Startup-only upgrade of the qualified H169 evaluator. Preserve its dependencies,
# benchmark definitions, isolated vLLM environment, and sandbox resources.
ARG BASE_IMAGE=gcr.io/ai2-beaker-core/public/dbjoksqptk0s73c835pg@sha256:49d508fe45f2bb360ebb43237dc0689d802714824263fae9dd6b5ae9f94d8701
FROM ${BASE_IMAGE}
ARG OLMO_EVAL_REVISION=ba0ff700e8f9b301cfd8ed5fd462df9d83dddfe1
LABEL ai2.olmo.eval.revision=${OLMO_EVAL_REVISION}
RUN test "$(git -C /opt/olmo-eval rev-parse HEAD)" = ede61eb914c0cae312c9c8112389afbe524fb096 \
    && git -C /opt/olmo-eval fetch origin ${OLMO_EVAL_REVISION} \
    && git -C /opt/olmo-eval checkout --detach ${OLMO_EVAL_REVISION} \
    && python -c "from olmo_eval.inference.providers.vllm_server_utils import DEFAULT_STARTUP_TIMEOUT; assert DEFAULT_STARTUP_TIMEOUT == 1200"

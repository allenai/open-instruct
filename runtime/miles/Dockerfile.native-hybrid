# Build on Beaker from the qualified hybrid runtime, loaded under this local tag.
FROM olmicro-native-parent:latest
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=${SOURCE_REVISION}
COPY open_instruct /opt/core-rl/open_instruct
COPY scripts/miles /opt/core-rl/scripts/miles
COPY runtime/miles/runtime.lock.json /opt/core-rl/runtime/miles/runtime.lock.json
COPY runtime/miles/runtime.lock.json /opt/core-rl/build/runtime/miles/runtime.lock.json
COPY miles/miles /opt/core-rl/sources/miles/miles
COPY miles/miles_plugins /opt/core-rl/sources/miles/miles_plugins
COPY sglang /sgl-workspace/sglang
RUN printf '%s\n' "$SOURCE_REVISION" > /opt/core-rl/source-revision
RUN python -m compileall -q /opt/core-rl/open_instruct/miles /opt/core-rl/sources/miles/miles /sgl-workspace/sglang/python/sglang/srt/models/mainline_ladder.py
RUN python -c "from open_instruct.miles.configuration.config import RunConfig"
WORKDIR /opt/core-rl

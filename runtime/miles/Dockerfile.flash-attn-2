# Step 2 of 2: adds FlashAttention 2 (sm_80/sm_90) so Core's flash_2 backend runs on A100 (ai2/saturn)
# and other non-Blackwell GPUs. Produced the base pinned in runtime.lock.json
# (Beaker 01M4XPGCV8JSYBTM1W3882N72G) from the Dockerfile.flash-attn-3 base (Beaker 01M4WKW6THBXKR9QVNQYV8PXTF).
#
# Wheels, placed in the build context:
#   flash_attn 2.8.3.post1, prebuilt for CUDA 13.0 / torch 2.13 / cp312 by the Astral GPU index:
#     https://wheels.astral.sh/simple/cu130/flash-attn/
#   flash-attn-4 4.0.0b27 from PyPI, byte-identical to the base's installed copy.
# flash_attn ships its own flash_attn/cute, which would replace FlashAttention 4's; reinstalling
# flash-attn-4 afterwards restores its files exactly.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
COPY flash_attn-2.8.3.post1+cu.13.0.torch.2.13-cp312-cp312-manylinux_2_24_x86_64.manylinux_2_28_x86_64.whl flash_attn_4-4.0.0b27-py3-none-any.whl /tmp/fa/
RUN echo "ab12a5b17f33f0d3381044f70006fa5891ec18404b412cc3a7517e5f2315534e  /tmp/fa/flash_attn-2.8.3.post1+cu.13.0.torch.2.13-cp312-cp312-manylinux_2_24_x86_64.manylinux_2_28_x86_64.whl" | sha256sum -c - \
 && echo "c84fedab172419f87bd1daf019ecd268595f512a5967ff90b74a0a601f578e07  /tmp/fa/flash_attn_4-4.0.0b27-py3-none-any.whl" | sha256sum -c - \
 && uv pip install --system --no-deps /tmp/fa/flash_attn-2.8.3.post1*.whl \
 && uv pip install --system --no-deps --reinstall /tmp/fa/flash_attn_4-4.0.0b27-py3-none-any.whl \
 && rm -rf /tmp/fa

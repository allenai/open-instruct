FROM us-docker.pkg.dev/ai2-olmo/olmo/maxtext-posttrain@sha256:18a36668969fbd985b222bf1f482f987aee2a4cdddfb9844d842843fc38ea2e7
RUN python -m pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu 'torch==2.11.0+cpu' && python -c 'import torch, orbax.checkpoint, jax; print(torch.__version__, jax.__version__)'
ENV JAX_PLATFORMS=cpu OMP_NUM_THREADS=8 MKL_NUM_THREADS=8

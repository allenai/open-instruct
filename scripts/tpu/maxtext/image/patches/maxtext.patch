+class MaxTextDPOTrainer(DPOTrainer):
+  """Tunix's DPOTrainer with a loss mask separate from attention, length-normalized DPO, and no dense mask.
+
+  - The loss mask is `{chosen,rejected}_loss_mask` when the data provides it (dpo.pretokenized), else the completion
+    attention mask.
+  - dpo.loss_type=dpo_norm averages each sequence's log-probs over its loss tokens, as open-instruct's dpo_norm does.
+    Weighting the loss mask by 1/count makes Tunix's summed log-probs those averages, for the policy and the
+    reference alike, so Tunix's DPO loss applies unchanged.
+  - Tunix materializes a [B, L, L] attention mask; it is passed as None instead, and the MaxText adapter derives
+    segment ids from `input_tokens != pad_id`. That is exact here because padding is only ever trailing and the pad
+    id never occurs as a real token (DPOPretokenizedFormatting checks this).
+  """
+
+  def __init__(self, *args, loss_type: str = "dpo", **kwargs):
+    super().__init__(*args, **kwargs)
+    self.loss_type = loss_type
+
+  @override
+  def _prepare_inputs(self, training_input: Any) -> Any:
+    x = training_input
+    prompt_ids = jnp.concatenate([x["prompt_ids"], x["prompt_ids"]], axis=0)
+    prompt_mask = jnp.concatenate([x["prompt_mask"], x["prompt_mask"]], axis=0)
+    completion_ids = jnp.concatenate([x["chosen_ids"], x["rejected_ids"]], axis=0)
+    completion_mask = jnp.concatenate([x["chosen_mask"], x["rejected_mask"]], axis=0)
+    loss_mask = jnp.concatenate(
+        [x.get("chosen_loss_mask", x["chosen_mask"]), x.get("rejected_loss_mask", x["rejected_mask"])], axis=0
+    ).astype(jnp.float32)
+    if self.loss_type == "dpo_norm":
+      loss_mask = loss_mask / jnp.maximum(loss_mask.sum(axis=-1, keepdims=True), 1.0)
+    input_ids = jnp.concatenate([prompt_ids, completion_ids], axis=1)
+    mask = jnp.concatenate([prompt_mask, completion_mask], axis=1)
+    positions = tunix_common.build_positions_from_mask(mask)
+    logits_to_keep = completion_ids.shape[1]
+    ref_chosen_logps = ref_rejected_logps = None
+    if self._ref_model_exists:
+      ref_chosen_logps, ref_rejected_logps, _ = compute_logps(
+          self.ref_model, input_ids, positions, None, logits_to_keep, loss_mask
+      )
+    return TrainExample(
+        input_ids=input_ids,
+        positions=positions,
+        attention_mask=None,
+        ref_chosen_logps=ref_chosen_logps,
+        ref_rejected_logps=ref_rejected_logps,
+        completion_mask=loss_mask,
+        logits_to_keep=logits_to_keep,
+        images=None,
+        full_mask=mask,
+    )

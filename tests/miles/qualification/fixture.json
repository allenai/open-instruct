{
  "name": "tiny-hybrid-moe-v1",
  "seed": 17,
  "tokenizer": "self-contained byte-level BPE, vocabulary 512",
  "prompts": [
    {
      "input": "Question: What is two plus three?\nAnswer:",
      "label": "5"
    },
    {
      "input": "Question: What is six times seven?\nAnswer:",
      "label": "42"
    },
    {
      "input": "Question: What is nine minus four?\nAnswer:",
      "label": "5"
    }
  ],
  "model": {
    "vocab_size": 512,
    "hidden_size": 128,
    "attention_hidden_size": 128,
    "head_dim": 32,
    "num_hidden_layers": 3,
    "num_attention_heads": 4,
    "num_key_value_heads": 2,
    "moe_intermediate_size": 256,
    "n_routed_experts": 4,
    "num_experts_per_tok": 2,
    "shared_expert_intermediate_size": 128,
    "latent_moe_dim": 64,
    "dense_layers_indices": [
      0
    ],
    "dense_mlp_intermediate_size": 256,
    "dense_mlp_uses_shared_experts": true,
    "layer_types": [
      "linear_attention",
      "linear_attention",
      "full_attention"
    ],
    "linear_num_key_heads": 8,
    "linear_num_value_heads": 8,
    "linear_key_head_dim": 64,
    "linear_value_head_dim": 64,
    "use_rope": false,
    "attention_gate_type": "elementwise",
    "use_head_qk_norm": true,
    "use_peri_ln": true,
    "max_position_embeddings": 512,
    "sliding_window": 512,
    "bos_token_id": 0,
    "eos_token_id": 0,
    "pad_token_id": 0
  },
  "comparison": {
    "rtol": 1e-05,
    "atol": 1e-06
  },
  "interpretation": "Greedy generation and router auxiliary losses test mechanics and resume consistency, not task learning.",
  "optimizer_moments_comparison": {
    "rtol": 1e-05,
    "atol": 1e-12
  }
}

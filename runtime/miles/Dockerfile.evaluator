# Build on a qualified MILES image to retain Olmo MoE SGLang architecture support.
# The independent CPU eval environment avoids changing serving's torch/transformers.
ARG SERVING_IMAGE
FROM ${SERVING_IMAGE}
ARG OLMO_EVAL_REVISION=710b2b5dab6ea09764c02647f3a4e72819b9ee7c
LABEL ai2.olmo.eval.revision=${OLMO_EVAL_REVISION}
RUN git clone https://github.com/allenai/olmo-eval.git /opt/olmo-eval \
    && git -C /opt/olmo-eval checkout --detach ${OLMO_EVAL_REVISION} \
    && test "$(git -C /opt/olmo-eval rev-parse HEAD)" = "${OLMO_EVAL_REVISION}"
RUN cd /opt/olmo-eval \
    && UV_PROJECT_ENVIRONMENT=/opt/evaluator-venv uv sync --frozen --no-default-groups --extra clients --extra hf --extra beaker
# Keep `python` pointing to serving's interpreter; only olmo-eval uses this venv.
RUN ln -s /opt/evaluator-venv/bin/olmo-eval /usr/local/bin/olmo-eval

# CLI dry-run does not import provider dependencies; check the actual adapter.
RUN /opt/evaluator-venv/bin/python -c "from olmo_eval.inference.providers import vllm_server"

# Task names in the maintained background-evaluation example must resolve here.
RUN /opt/evaluator-venv/bin/python -c "from olmo_eval.evals.tasks.common import get_task; [get_task(name) for name in ('gsm8k', 'gsm8k:platinum', 'ifeval_ood')]"

# CLI stop-list overrides must remain hashable for async request batching.
RUN /opt/evaluator-venv/bin/python -c "from dataclasses import replace; from olmo_eval.cli.run.config import _parse_override_value; from olmo_eval.common.types import SamplingParams; [hash(replace(SamplingParams(), stop_sequences=_parse_override_value(value))) for value in ('[]', '[\"END\"]')]"
